# Hybrid Stack Configuration

# Database
# appuser = admin role (SUPERUSER), used for migrations and for applying
# rls-and-audit.sql. Never for application traffic.
DB_PASSWORD=your_secure_db_password_here

# hybrid_app = application role, NOSUPERUSER/NOBYPASSRLS, created by
# 01-init-roles.sh. RLS policies apply to this role: connecting as appuser
# would silently disable multi-tenant isolation entirely.
APP_DB_PASSWORD=your_secure_app_password_here
DATABASE_URL=postgresql://hybrid_app:your_app_password@localhost:5432/shared_meta

# Host ports (useful when a native PostgreSQL/Redis already holds the defaults)
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
DJANGO_HOST_PORT=8000
NEXTJS_HOST_PORT=3000

# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com

# Sync Configuration
SYNC_CONFLICT_RESOLUTION_STRATEGY=last-write-wins
SYNC_AUTO_PURGE_SYNCED_AFTER_DAYS=90
SYNC_COMPRESSION_THRESHOLD=1000

# JWT Tokens
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ACCESS_TOKEN_LIFETIME=86400  # 24 hours in seconds
JWT_REFRESH_TOKEN_LIFETIME=604800  # 7 days

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Hybrid ERP
NEXT_PUBLIC_VERSION=1.0.0

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# AWS (for backups)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_STORAGE_BUCKET_NAME=backups-comores
AWS_S3_REGION_NAME=eu-west-1

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=true

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# Tenant Mode
TENANT_MODE=local  # 'local' for site installation, 'central' for server
CURRENT_TENANT_ID=tenant_cmr_001

# Feature Flags
FEATURE_CRDT_SYNC=true
FEATURE_OFFLINE_MODE=true
FEATURE_AUDIT_LOGS=true
FEATURE_CONFLICT_RESOLUTION=true
